# Copy to .env for local development. NEVER commit real values.
# Production values come from Secret Manager / Cloud Run env vars (see deploy/deploy.sh).

DUKAANPILOT_ENV=dev
DUKAANPILOT_STORE=sqlite            # sqlite | firestore
DUKAANPILOT_SEED_DEMO=true          # creates the demo kirana store (dev only)
DUKAANPILOT_MODEL=gemini-3.5-flash  # verify the exact model id available in your project/region
DUKAANPILOT_TZ=Asia/Kolkata

# Gemini through Vertex AI (recommended on Google Cloud) ...
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# ... or a Gemini API key for quick local tries instead:
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=

# Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=            # long random string; Telegram sends it back on every webhook call

# Protects /internal/* and the ADK routes
INTERNAL_SHARED_SECRET=             # long random string, for developers calling jobs by hand
SCHEDULER_AUDIENCE=                 # your Cloud Run service URL
SCHEDULER_SERVICE_ACCOUNT=          # e.g. dukaanpilot-scheduler@PROJECT.iam.gserviceaccount.com
